{
  "name": "castro-retro",
  "version": "1.0.0",
  "scripts": {
    "build:css": "concurrently \"sass --watch ./styles/main.scss:./styles/compiled.css\" \"tailwindcss -i ./styles/compiled.css -o ./styles/output.css --watch\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "sass": "^1.87.0",
    "tailwindcss": "^3.4.1"
  }
}
